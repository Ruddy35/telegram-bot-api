+void Requests::on_request(uint64 id, const td_api::getMemoryObjectCounts &request) {
+  vector<td_api::object_ptr<td_api::memoryObjectCount>> counts;
+  auto add_count = [&counts](const char *type, size_t count) {
+    counts.push_back(td_api::make_object<td_api::memoryObjectCount>(type, static_cast<int64>(count)));
+  };
+  const auto *file_manager = td_->file_manager_.get();
+  add_count("file_id", file_manager->file_id_info_.size());
+  add_count("file_node", file_manager->file_nodes_.size());
+  add_count("remote_file_location", file_manager->remote_location_info_.size());
+  add_count("local_file_location", file_manager->local_location_to_file_id_.size());
+  add_count("file_source", td_->file_reference_manager_->file_sources_.size());
+  add_count("file_reference_node", td_->file_reference_manager_->nodes_.calc_size());
+  add_count("chat", td_->messages_manager_->dialogs_.calc_size());
+  add_count("message", static_cast<size_t>(td_->messages_manager_->loaded_message_count_));
+  add_count("message_file_source", td_->messages_manager_->message_full_id_to_file_source_id_.calc_size());
+  add_count("user", td_->user_manager_->users_.calc_size());
+  add_count("user_full_info", td_->user_manager_->users_full_.calc_size());
+  add_count("basic_group", td_->chat_manager_->chats_.calc_size());
+  add_count("basic_group_full_info", td_->chat_manager_->chats_full_.calc_size());
+  add_count("supergroup", td_->chat_manager_->channels_.calc_size());
+  add_count("min_supergroup", td_->chat_manager_->min_channels_.calc_size());
+  add_count("supergroup_full_info", td_->chat_manager_->channels_full_.calc_size());
+  add_count("animation", td_->animations_manager_->animations_.calc_size());
+  add_count("audio", td_->audios_manager_->audios_.calc_size());
+  add_count("document", td_->documents_manager_->documents_.calc_size());
+  add_count("sticker", td_->stickers_manager_->stickers_.calc_size());
+  add_count("sticker_set", td_->stickers_manager_->sticker_sets_.calc_size());
+  add_count("video", td_->videos_manager_->videos_.calc_size());
+  add_count("video_note", td_->video_notes_manager_->video_notes_.calc_size());
+  add_count("voice_note", td_->voice_notes_manager_->voice_notes_.calc_size());
+  add_count("web_page", td_->web_pages_manager_->web_pages_.calc_size());
+  add_count("poll", td_->poll_manager_->polls_.calc_size());
+  add_count("story", td_->story_manager_->stories_.calc_size());
+  send_closure(td_actor_, &Td::send_result, id, td_api::make_object<td_api::memoryObjectCounts>(std::move(counts)));
+}
